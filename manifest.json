{
  "schemaVersion": 1,
  "id": "io.github.maplepreneur.omarchy-windscribe",
  "name": "Windscribe",
  "version": "1.0.1",
  "author": "maplepreneur",
  "license": "MIT",
  "description": "Windscribe VPN, built for Omarchy. No terminal: one click to connect, a world map of cities, firewall and split tunneling, in a widget that wears every Omarchy theme.",
  "kinds": [
    "bar-widget"
  ],
  "entryPoints": {
    "barWidget": "Panel.qml"
  },
  "barWidget": {
    "displayName": "Windscribe",
    "description": "Toggle Windscribe, quick-connect, save named profiles in your theme's colours, pick a region or city, connect to your static IPs, and manage the firewall, split tunneling and Always On.",
    "category": "Network",
    "allowMultiple": false,
    "defaultSection": "right",
    "defaults": {
      "watchIntervalSec": 4,
      "notifications": "on"
    },
    "schema": [
      {
        "key": "watchIntervalSec",
        "type": "integer",
        "label": "Status watch interval (seconds)",
        "min": 2,
        "max": 60,
        "step": 1,
        "defaultValue": 4
      },
      {
        "key": "notifications",
        "type": "enum",
        "label": "Desktop notifications",
        "options": [
          {
            "value": "on",
            "label": "On"
          },
          {
            "value": "off",
            "label": "Off"
          }
        ],
        "defaultValue": "on"
      }
    ]
  }
}
